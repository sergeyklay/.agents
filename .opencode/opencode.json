{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "small_model": "litellm/openai/gpt-5.6-luna",
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "scan-security": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.env.dist": "allow",
      ".env.example": "allow",
      ".env.sample": "allow",
      ".env.template": "allow",
      ".env.dist": "allow"
    },
    "external_directory": {
      "~/work/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills/**": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm-proxy.infrateam-dev.xyz/v1",
        "timeout": 600000,
        "headerTimeout": 120000,
        "chunkTimeout": 300000,
        "includeUsage": true
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "balanced": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "deep": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            }
          }
        },
        "openai/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "balanced": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "deep": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            }
          }
        },
        "openai/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1050000,
            "output": 128000
          },
          "variants": {
            "fast": {
              "reasoningEffort": "low",
              "textVerbosity": "low"
            },
            "balanced": {
              "reasoningEffort": "medium",
              "textVerbosity": "medium"
            },
            "deep": {
              "reasoningEffort": "high",
              "textVerbosity": "medium"
            }
          }
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "anthropic/claude-sonnet-5": {
          "name": "Claude Sonnet 5",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    },
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1",
        "timeout": 600000
      },
      "models": {
        "qwen3.8:27b": {
          "name": "Qwen 3.8 27B",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text", "image"], "output": ["text"] },
          "limit": { "context": 65536, "output": 16384 }
        },
        "qwen3.6:27b": {
          "name": "Qwen 3.6 27B",
          "attachment": true,
          "reasoning": true,
          "temperature": true,
