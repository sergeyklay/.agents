        },
        "gpt-oss:20b": {
          "name": "GPT-OSS 20B",
          "reasoning": true,
          "temperature": true,
          "tool_call": true,
          "modalities": { "input": ["text"], "output": ["text"] },
          "limit": { "context": 65536, "output": 16384 }
        }
      }
    }
  }
}
