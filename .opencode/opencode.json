{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "scan-security": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.env.dist": "allow",
      ".env.example": "allow",
      ".env.sample": "allow",
      ".env.template": "allow",
      ".env.dist": "allow"
    },
    "external_directory": {
      "*": "ask",
      "~/work/**": "allow",
      "/tmp/opencode/**": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  }
}
