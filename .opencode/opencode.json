{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "instructions": [
    "~/.config/opencode/rules/*.md"
  ],
  "subagent_depth": 2,
  "permission": {
    "skill": {
      "scan-security": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      "*.env": "deny",
      "*.env.*": "deny",
      ".env.*": "deny",
      "*.env.example": "allow",
      "*.env.sample": "allow",
      "*.env.template": "allow",
      "*.env.dist": "allow",
      ".env.example": "allow",
      ".env.sample": "allow",
      ".env.template": "allow",
      ".env.dist": "allow"
    },
    "external_directory": {
      "~/work/**": "allow",
      "~/.config/opencode/**": "allow",
      "~/.claude/skills/**": "allow"
    },
    "doom_loop": "deny"
  },
  "mcp": {
    "atlassian": {
      "type": "remote",
      "url": "https://mcp.atlassian.com/v1/mcp",
      "enabled": true
    },
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    }
  },
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://litellm-proxy.infrateam-dev.xyz/v1"
      },
      "models": {
        "openai/gpt-5.6-sol": {
          "name": "GPT-5.6 Sol",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "openai/gpt-5.6-terra": {
          "name": "GPT-5.6 Terra",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "openai/gpt-5.6-luna": {
          "name": "GPT-5.6 Luna",
          "limit": {
            "context": 1050000,
            "output": 128000
          }
        },
        "anthropic/claude-opus-5": {
          "name": "Claude Opus 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        },
        "anthropic/claude-sonet-5": {
          "name": "Claude Sonet 5",
          "limit": {
            "context": 1000000,
            "output": 128000
          }
        }
      }
    }
  }
}
