{
  "$schema": "https://raw.githubusercontent.com/DetachHead/basedpyright/main/packages/vscode-pyright/schemas/pyrightconfig.schema.json",
  "include": ["."],
  "exclude": ["**/.git", "**/.ruff_cache", "**/.venv", "**/__pycache__", "**/node_modules"],
  "executionEnvironments": [
    {
      "root": "test",
      "extraPaths": [
        ".agents/skills/audit-agent/scripts",
        ".agents/skills/babysit-pr/scripts",
        ".agents/skills/make-skill/scripts"
      ]
    }
  ],
  "pythonVersion": "3.9",
  "typeCheckingMode": "strict",
  "failOnWarnings": true
}
