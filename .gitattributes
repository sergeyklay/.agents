# POSIX tooling (shell scripts, shfmt, CI) requires LF everywhere.
* text=auto eol=lf

# Shell: better hunk headers in diffs; mark .bats as bash for linguist.
*.sh diff=bash
*.bash diff=bash
*.bats diff=bash linguist-language=bash

# Python syntax requires indentation with spaces or consistent tabs.
*.py whitespace=trailing-space,space-before-tab

# Bats heredocs embed space-indented source in shell files.
*.bats whitespace=trailing-space,space-before-tab
